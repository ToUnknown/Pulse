      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0OUI2QUIyRkQ4NDY2OTUKUldTVlpvVDlzbXFieEovYkZ4U3ltTXRYajNORjJxNTR5bUhkNGErM0t6QlVGRnBDZVpnVG1iYkcK",
      "endpoints": [
        "https://github.com/ToUnknown/Pulse/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
