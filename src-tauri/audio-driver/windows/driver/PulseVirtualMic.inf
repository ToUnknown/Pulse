[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%ProviderName%
DriverVer=08/25/2026,1.0.0.0
CatalogFile=PulseVirtualMic.cat
PnpLockDown=1

[Manufacturer]
%ManufacturerName%=Pulse,NTamd64.10.0...19041

[Pulse.NTamd64.10.0...19041]
%DeviceDescription%=PulseVirtualMic,ROOT\PulseVirtualMic

[DestinationDirs]
PulseVirtualMic.Copy=13

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
PulseVirtualMic.sys=1

[PulseVirtualMic.Copy]
PulseVirtualMic.sys

[PulseVirtualMic.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=PulseVirtualMic.Copy
AddReg=PulseVirtualMic.AddReg

[PulseVirtualMic.NT.HW]
AddReg=PulseVirtualMic.Security

[PulseVirtualMic.Security]
HKR,,DeviceType,0x00010001,0x0000001D
HKR,,Security,,"D:P(D;;GA;;;S-1-5-2)(D;;GA;;;S-1-5-14)(A;;GA;;;SY)(A;;GA;;;BA)(A;;GRGWGX;;;IU)"

[PulseVirtualMic.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,PulseVirtualMic.sys
HKR,Drivers,SubClasses,,"wave"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDescription%

[PulseVirtualMic.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_PulseWave%,Pulse.Wave
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_PulseWave%,Pulse.Wave
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_PulseWave%,Pulse.Wave
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_PulseTopology%,Pulse.Topology
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_PulseTopology%,Pulse.Topology

[Pulse.Wave]
AddReg=Pulse.Wave.AddReg

[Pulse.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%EndpointName%

[Pulse.Topology]
AddReg=Pulse.Topology.AddReg

[Pulse.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%EndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_FormFactor%,0x00010001,4
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1
HKR,EP\0,%PKEY_AudioEngine_OEMFormat%,1,fe,ff,01,00,80,bb,00,00,00,77,01,00,02,00,10,00,16,00,10,00,04,00,00,00,01,00,00,00,00,00,10,00,80,00,00,aa,00,38,9b,71

[PulseVirtualMic.NT.Services]
AddService=PulseVirtualMic,0x00000002,PulseVirtualMic.Service

[PulseVirtualMic.Service]
DisplayName=%ServiceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\PulseVirtualMic.sys

